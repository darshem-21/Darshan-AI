# Supabase Authentication & Database (Frontend only exposes Project URL and Public Anon Key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# FastAPI Backend URL (optional - defaults to http://localhost:8000)
VITE_API_URL="http://localhost:8000"

# Note on Security:
# NEVER put SUPABASE_SERVICE_ROLE_KEY or OPENROUTER_API_KEY here.
# Keep those secrets exclusively inside backend/.env
