# VITE_API_URL: Base URL for your Python FastAPI backend (optional).
# Defaults to mock agent simulation if unset or unreachable.
# Example: http://localhost:8000
VITE_API_URL="http://localhost:8000"

# GEMINI_API_KEY: Optional if server uses Gemini directly.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

