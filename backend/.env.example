# Darshan AI Backend Configuration

# OpenRouter API key (server-side secret; choose an available free model)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"
OPENROUTER_DEFAULT_MODEL="openrouter/free"

# Supabase Integration (use the JWT-style service_role key; backend only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"
# Token validation is performed through Supabase Auth; legacy JWT secret is not required.

# Optional GitHub Personal Access Token (for higher rate limits on repository analysis)
GITHUB_TOKEN=""

# REA (Reverse Engineer Anything) Configuration
# Optional CLI path. Public-host CLI execution is disabled by default.
# Leave REA_CLI_PATH empty to use the pinned local install (backend/rea/node_modules/.bin/rea).
REA_CLI_PATH=""
REA_TELEMETRY="false"
ENABLE_REA_CLI_EXECUTION="false"

# Security & Execution Sandbox
REQUIRE_HUMAN_APPROVAL_FOR_TOOLS="true"
ALLOWED_EXTENSIONS=".pdf,.txt,.md,.py,.js,.ts,.json"
MAX_UPLOAD_SIZE_MB="25"

# Server Host & Port
HOST="0.0.0.0"
PORT="8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://YOUR-PROJECT.pages.dev"
